HOST=127.0.0.1
PORT=5173
PUBLIC_ORIGIN=
VOLCENGINE_API_KEY=
VOLCENGINE_TEXT_MODEL=
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-5-251128
DAILY_IMAGE_LIMIT=20
COOKIE_SECURE=false

# Alibaba Cloud Bailian: video uses DashScope, not OpenAI compatible mode
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://llm-zox3pv2a4xrvokvg.cn-beijing.maas.aliyuncs.com/api/v1
BAILIAN_VIDEO_MODEL=wan3.0-video
DAILY_VIDEO_LIMIT=12

# Optional: route the text or image channel to a different OpenAI-compatible
# endpoint (for example Alibaba Cloud Bailian) instead of Volcengine Ark.
# Setting TEXT_BASE_URL or IMAGE_BASE_URL switches that channel on its own;
# leave them blank to keep using Ark.
# Bailian endpoint format: https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
# The API key must belong to the same region as the endpoint: cross-region calls fail.
# When TEXT_BASE_URL is set, TEXT_API_KEY falls back to BAILIAN_API_KEY if left blank.
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
IMAGE_BASE_URL=
IMAGE_MODEL=

# Install FFmpeg + FFprobe locally; leave blank when available in PATH
FFMPEG_PATH=
FFPROBE_PATH=
